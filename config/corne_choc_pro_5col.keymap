#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    macros {
        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE>;
            label = "TILDE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
  &kp Q               &kp W  &kp F          &kp P           &kp B        &studio_unlock  &rgb_ug RGB_TOG  &kp J        &kp L       &kp U         &kp Z       &none
  &kp A               &kp R  &kp S          &kp T           &kp G        &none           &none            &kp M        &kp N       &kp E         &kp I       &kp O
  &mt LEFT_CONTROL Y  &kp X  &kp C          &kp D           &kp V                                         &kp K        &kp H       &kp DE_COMMA  &kp DE_DOT  &mt LEFT_CONTROL DE_ESZETT
                             &kp BACKSPACE  &kp LEFT_SHIFT  &lt 2 ENTER                                   &lt 1 SPACE  &kp ESCAPE  &kp LEFT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbolsAndNav {
            display-name = "symbolsAndNav";

            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |

            bindings = <
  &kp DE_DOLLAR     &kp DE_LESS_THAN      &kp DE_HASH       &kp DE_GREATER_THAN  &kp DE_LEFT_BRACE        &none  &none  &kp DE_PERCENT  &kp C_VOLUME_UP    &kp PAGE_DOWN    &kp PAGE_UP      &kp DE_EURO
  &kp DE_EXCL       &kp DE_DOUBLE_QUOTES  &kp DE_AMPERSAND  &kp DE_UNDERSCORE    &kp DE_LEFT_PARENTHESIS  &none  &none  &kp TAB         &kp LEFT           &kp DOWN         &kp UP           &kp RIGHT
  &kp LEFT_CONTROL  &kp LEFT_ALT          &kp DE_PIPE       &kp DE_EQUAL         &kp DE_LEFT_BRACKET                    &kp DE_AT       &kp C_VOLUME_DOWN  &kp DE_U_UMLAUT  &kp DE_A_UMLAUT  &kp DE_O_UMLAUT
                                          &none             &kp LEFT_SHIFT       &kp LEFT_GUI                           &none           &none              &none
            >;
        };

        num {
            display-name = "num";

            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |

            bindings = <
  &none      &kp DE_CARET         &kp DE_TILDE  &kp DE_BACKSLASH  &kp DE_RIGHT_BRACE        &studio_unlock  &rgb_ug RGB_TOG  &kp DE_ASTRK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none
  &none      &kp DE_SINGLE_QUOTE  &kp DE_DOT    &kp LS(DE_DOT)    &kp DE_RIGHT_PARENTHESIS  &bt BT_CLR_ALL  &none            &kp DE_MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DE_SLASH
  &kp EQUAL  &kp LS(EQUAL)        &none         &kp DE_COMMA      &kp DE_RIGHT_BRACKET                                       &kp DE_PLUS   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0
                                  &none         &none             &none                                                      &kp RETURN    &none         &none
            >;
        };
    };
};
