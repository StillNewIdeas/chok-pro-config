#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
  &kp Q               &kp W  &kp F          &kp P           &kp B        &studio_unlock  &kp MINUS  &kp J        &kp L       &kp U         &kp Z    &to 3
  &kp A               &kp R  &kp S          &kp T           &kp G        &kp LALT        &kp RALT   &kp M        &kp N       &kp E         &kp I    &kp O
  &mt LEFT_CONTROL Y  &kp X  &kp C          &kp D           &kp V                                   &kp K        &kp H       &kp COMMA     &kp DOT  &mt LEFT_CONTROL A
                             &kp BACKSPACE  &kp LEFT_SHIFT  &lt 2 ENTER                             &lt 1 SPACE  &kp ESCAPE  &kp LEFT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbolsAndNav {
            display-name = "symbolsAndNav";

            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |

            bindings = <
  &none             &kp NON_US_BSLH   &kp LS(NON_US_BSLH)  &kp NON_US_HASH  &kp RA(N7)    &none  &none  &kp LS(NUMBER_5)  &kp C_VOLUME_UP    &kp PAGE_DOWN  &kp PAGE_UP     &none
  &kp LS(NUMBER_6)  &kp LS(NUMBER_2)  &kp LS(NUMBER_1)     &kp LS(SLASH)    &kp LS(N8)    &none  &none  &kp TAB           &kp LEFT           &kp DOWN       &kp UP          &kp RIGHT
  &kp LEFT_CONTROL  &kp LEFT_ALT      &kp RA(NON_US_BSLH)  &kp LS(N0)       &kp RA(N8)                  &kp RA(Q)         &kp C_VOLUME_DOWN  &kp APOS       &kp LEFT_BRACE  &kp SEMICOLON
                                      &none                &kp LEFT_SHIFT   &kp LEFT_GUI                &none             &none              &none
            >;
        };

        num {
            display-name = "num";

            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |

            bindings = <
  &none      &none          &none         &none             &kp DE_RIGHT_BRACE        &none  &none  &kp KP_ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none
  &kp EQUAL  &kp LS(EQUAL)  &kp DE_TILDE  &kp DE_BACKSLASH  &kp DE_RIGHT_PARENTHESIS  &none  &none  &kp KP_MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_DIVIDE
  &none      &none          &none         &kp DE_CARET      &kp DE_RIGHT_BRACKET                    &kp KP_PLUS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0
                            &none         &none             &none                                   &none            &none         &none
            >;
        };

        mouse {
            display-name = "mouse";
            bindings = <
  &studio_unlock   &none      &none      &none      &none  &none  &none  &none  &none               &none              &none               &to 0
  &rgb_ug RGB_TOG  &mkp MCLK  &mkp RCLK  &mkp LCLK  &none  &none  &none  &none  &mmv MOVE_X(-2500)  &mmv MOVE_Y(2500)  &mmv MOVE_Y(-2500)  &mmv MOVE_X(2500)
  &bt BT_CLR_ALL   &none      &none      &none      &none                &none  &mmv MOVE_LEFT      &mmv MOVE_DOWN     &mmv MOVE_UP        &mmv MOVE_RIGHT
                              &none      &none      &none                &none  &none               &none
            >;
        };
    };
};
