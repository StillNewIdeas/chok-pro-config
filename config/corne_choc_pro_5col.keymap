#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
  &kp Q               &kp W  &kp F          &kp P           &kp B        &studio_unlock  &none     &kp J        &kp L         &kp U       &kp Z    &to 3
  &kp A               &kp R  &kp S          &kp T           &kp G        &kp LALT        &kp RALT  &kp M        &kp N         &kp E       &kp I    &kp O
  &mt LEFT_CONTROL Y  &kp X  &kp C          &kp D           &kp V                                  &kp K        &kp H         &kp COMMA   &kp DOT  &mt LEFT_CONTROL A
                             &kp BACKSPACE  &kp LEFT_SHIFT  &lt 2 ENTER                            &lt 1 SPACE  &kp LEFT_GUI  &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbols {
            display-name = "symbols";

            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |

            bindings = <
  &kp A             &none         &none         &none      &kp RA(N7)  &none     &none     &none    &none     &none      &none      &none
  &kp LGUI          &kp LALT      &kp LCTRL     &kp LSHFT  &kp LS(N8)  &kp LALT  &kp RALT  &kp TAB  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT
  &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &none      &kp RA(N8)                      &kp INS  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END
                                  &none         &none      &none                           &none    &none     &none
            >;
        };

        num {
            display-name = "num";

            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |

            bindings = <
  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &kp RA(N0)        &none  &none  &kp KP_ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none
  &kp C_PREV       &kp C_VOL_DN     &kp C_MUTE       &kp C_VOL_UP     &kp LS(NUMBER_9)  &none  &none  &kp KP_MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DIVIDE
  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &none            &kp RA(NUMBER_9)                &kp KP_PLUS      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0
                                    &none            &none            &none                           &none            &none            &none
            >;
        };

        mouse {
            display-name = "mouse";
            bindings = <
  &studio_unlock   &none      &none      &none      &none  &none  &none  &none  &none              &none           &none         &to 0
  &rgb_ug RGB_TOG  &mkp MCLK  &mkp RCLK  &mkp LCLK  &none  &none  &none  &none  &mmv MOVE_LEFT     &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
  &bt BT_CLR_ALL   &none      &none      &none      &none                &none  &mmv MOVE_X(-1000)  &none           &none         &none
                              &none      &none      &none                &none  &none              &none
            >;
        };
    };
};
