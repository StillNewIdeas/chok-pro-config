#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <280>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    macros {
        walrus: walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(DOT) &kp DE_EQUAL>;
            label = "walrus";
        };

        backtick: forwardtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL) &kp LS(EQUAL)>;
            label = "FORWARDTICK";
        };
    };

    behaviors {
        umlaute_tap: umlaute_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "UMLAUTE_TAP";
            #binding-cells = <0>;
            bindings = <&kp DE_U_UMLAUT>, <&kp DE_A_UMLAUT>, <&kp DE_O_UMLAUT>;

            tapping-term-ms = <200>;
        };

        parenthesis: parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp DE_LEFT_PARENTHESIS>, <&kp DE_RIGHT_PARENTHESIS>;
        };

        brace: brace {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACE";
            #binding-cells = <0>;
            bindings = <&kp DE_LEFT_BRACE>, <&kp DE_RIGHT_BRACE>;
        };

        bracket: bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKET";
            #binding-cells = <0>;
            bindings = <&kp DE_LEFT_BRACKET>, <&kp DE_RIGHT_BRACKET>;
        };

        dollar_euro: dollar_euro {
            compatible = "zmk,behavior-tap-dance";
            label = "DOLLAR_EURO";
            #binding-cells = <0>;
            bindings = <&kp DE_DOLLAR>, <&kp DE_EURO>;
        };

        backtick_forwardtick: backtick_forwardtick {
            compatible = "zmk,behavior-tap-dance";
            label = "BACKTICK_FORWARDTICK";
            #binding-cells = <0>;
            bindings = <&backtick>, <&kp EQUAL>;
        };

        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-tap-dance";
            label = "BACKSPACE_DELETE";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
        };

        logical_and_or: logical_and_or {
            compatible = "zmk,behavior-tap-dance";
            label = "LOGICAL_AND_OR";
            #binding-cells = <0>;
            bindings = <&kp DE_AMPS>, <&kp DE_PIPE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
  &kp Q     &kp W       &kp F              &kp P               &kp B        &kp C_VOLUME_UP    &kp PAGE_UP    &kp J        &kp L               &kp U           &kp DE_Y    &umlaute_tap
  &kp A     &mt LALT R  &mt LEFT_GUI S     &mt LEFT_CONTROL T  &kp G        &kp C_VOLUME_DOWN  &kp PAGE_DOWN  &kp M        &mt LEFT_CONTROL N  &mt LEFT_GUI E  &mt LALT I  &kp O
  &kp DE_Z  &kp X       &kp C              &kp D               &kp V                                          &kp K        &kp H               &kp DE_COMMA    &kp DE_DOT  &kp ESCAPE
                        &backspace_delete  &kp LEFT_SHIFT      &lt 2 ENTER                                    &lt 1 SPACE  &kp LEFT_SHIFT      &kp DE_ESZETT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbolsAndNav {
            display-name = "symbolsAndNav";

            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |

            bindings = <
  &backtick_forwardtick  &kp DE_PERCENT        &kp DE_HASH                    &dollar_euro               &brace        &rgb_ug RGB_TOG  &studio_unlock  &kp DE_COLON      &kp DE_LESS_THAN     &kp TAB       &kp DE_GREATER_THAN  &kp DE_BACKSLASH
  &kp DE_AT              &mt LEFT_ALT DE_EXCL  &mt LEFT_GUI DE_DOUBLE_QUOTES  &mt LEFT_CONTROL DE_UNDER  &parenthesis  &none            &bt BT_CLR_ALL  &logical_and_or   &kp LEFT             &kp DOWN      &kp UP               &kp RIGHT
  &kp DE_TILDE           &kp DE_ASTERISK       &walrus                        &kp DE_EQUAL               &bracket                                       &kp DE_SEMICOLON  &kp DE_SINGLE_QUOTE  &kp DE_MINUS  &kp DE_SLASH         &kp DE_PLUS
                                               &none                          &kp LEFT_SHIFT             &mo 2                                          &none             &kp LEFT_SHIFT       &none
            >;
        };

        num {
            display-name = "num";

            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |

            bindings = <
  &kp F12  &kp F11  &kp F10          &kp F9               &trans  &trans  &trans  &trans      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
  &kp F8   &kp F7   &mt LEFT_GUI F6  &mt LEFT_CONTROL F5  &trans  &trans  &trans  &kp DE_DOT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DE_COMMA
  &kp F4   &kp F3   &kp F2           &kp F1               &trans                  &trans      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0
                    &trans           &trans               &trans                  &mo 1       &trans        &trans
            >;
        };
    };
};
