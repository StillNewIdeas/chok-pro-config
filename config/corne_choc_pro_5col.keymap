#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <280>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    macros {
        walrus: walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(DOT) &kp DE_EQUAL>;
            label = "walrus";
        };

        backtick: forwardtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL) &kp LS(EQUAL)>;
            label = "FORWARDTICK";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(DE_C)>;
            label = "COPY";
        };
    };

    behaviors {
        dollar_euro: dollar_euro {
            compatible = "zmk,behavior-tap-dance";
            label = "DOLLAR_EURO";
            #binding-cells = <0>;
            bindings = <&kp DE_DOLLAR>, <&kp DE_EURO>;

            tapping-term-ms = <170>;
        };

        backtick_forwardtick: backtick_forwardtick {
            compatible = "zmk,behavior-tap-dance";
            label = "BACKTICK_FORWARDTICK";
            #binding-cells = <0>;
            bindings = <&backtick>, <&kp EQUAL>;

            tapping-term-ms = <170>;
        };

        layer_shift: shift_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&to>;
        };

        eszet_capslock: eszet_capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "ESZET_CAPSLOCK";
            #binding-cells = <0>;
            tapping-term-ms = <170>;
            bindings = <&kp DE_ESZETT>, <&kp CAPSLOCK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
  &kp Q     &kp W           &kp F           &kp P                      &kp B      &kp C_VOLUME_UP    &kp PAGE_UP    &kp J      &kp L                      &kp U           &kp DE_Y        &eszet_capslock
  &kp A     &mt LEFT_ALT R  &mt LEFT_GUI S  &mt LEFT_CONTROL T         &kp G      &kp C_VOLUME_DOWN  &kp PAGE_DOWN  &kp M      &mt LEFT_CONTROL N         &mt LEFT_GUI E  &mt LEFT_ALT I  &kp O
  &kp DE_Z  &kp X           &kp C           &kp D                      &kp V                                        &kp K      &kp H                      &kp DE_COMMA    &kp DE_DOT      &kp ESCAPE
                            &kp BACKSPACE   &layer_shift LEFT_SHIFT 2  &kp ENTER                                    &kp SPACE  &layer_shift LEFT_SHIFT 1  &kp TAB
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbolsAndNav {
            display-name = "symbolsAndNav";

            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |

            bindings = <
  &backtick_forwardtick  &kp DE_PERCENT    &kp DE_HASH                    &walrus                    &kp DE_LEFT_BRACE        &rgb_ug RGB_TOG  &studio_unlock  &kp DE_RIGHT_BRACE        &kp DE_LESS_THAN     &dollar_euro     &kp DE_GREATER_THAN  &kp DE_BACKSLASH
  &kp DE_AMPERSAND       &mt LALT DE_EXCL  &mt LEFT_GUI DE_DOUBLE_QUOTES  &mt LEFT_CONTROL DE_UNDER  &kp DE_LEFT_PARENTHESIS  &none            &bt BT_CLR_ALL  &kp DE_RIGHT_PARENTHESIS  &kp LEFT             &kp DOWN         &kp UP               &kp RIGHT
  &kp DE_PIPE            &kp DE_TILDE      &kp DE_AT                      &kp DE_EQUAL               &kp DE_LEFT_BRACKET                                       &kp DE_RIGHT_BRACKET      &kp DE_SINGLE_QUOTE  &kp DE_U_UMLAUT  &kp DE_A_UMLAUT      &kp DE_O_UMLAUT
                                           &to 0                          &layer_shift LEFT_SHIFT 2  &kp ENTER                                                 &kp SPACE                 &to 0                &none
            >;
        };

        num {
            display-name = "num";

            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |

            bindings = <
  &kp F12  &kp F11            &kp F10          &kp F9               &kp DE_RIGHT_BRACE        &trans  &trans  &kp DE_ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp DE_PERCENT
  &kp F8   &mt LEFT_SHIFT F7  &mt LEFT_GUI F6  &mt LEFT_CONTROL F5  &kp DE_RIGHT_PARENTHESIS  &trans  &trans  &kp DE_MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DE_SLASH
  &kp F4   &kp F3             &kp F2           &kp F1               &kp DE_RIGHT_BRACKET                      &kp DE_PLUS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0
                              &to 0            &to 1                &kp ENTER                                 &kp SPACE        &kp DE_DOT    &kp DE_COMMA
            >;
        };
    };
};
