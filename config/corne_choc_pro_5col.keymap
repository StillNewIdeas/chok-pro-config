#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <230>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    macros {
        walrus: walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(DOT) &kp DE_EQUAL>;
            label = "walrus";
        };

        backtick: backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp EQUAL>;
            label = "BACKTICK";
        };

        forwardtick: forwardtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL) &kp LS(EQUAL)>;
            label = "FORWARDTICK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";

            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
  &kp Q           &kp W           &kp F             &kp P               &kp B      &kp C_VOLUME_UP    &rgb_ug RGB_TOG  &kp J      &kp L               &kp U             &kp Z           &none
  &mt LEFT_ALT A  &mt LEFT_GUI R  &mt LEFT_SHIFT S  &mt LEFT_CONTROL T  &kp G      &kp C_VOLUME_DOWN  &none            &kp M      &mt LEFT_CONTROL N  &mt LEFT_SHIFT E  &mt LEFT_GUI I  &mt LEFT_ALT O
  &kp DE_Z        &kp X           &kp C             &kp D               &kp V                                          &kp K      &kp H               &kp DE_COMMA      &kp DE_DOT      &kp DE_ESZETT
                                  &kp BACKSPACE     &mo 2               &kp ENTER                                      &kp SPACE  &mo 1               &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbolsAndNav {
            display-name = "symbolsAndNav";

            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |

            bindings = <
  &kp DE_EURO       &kp DE_PERCENT  &kp DE_AMPERSAND      &kp DE_SINGLE_QUOTE  &mt DE_RIGHT_BRACE DE_LEFT_BRACE              &kp PAGE_UP    &studio_unlock  &none    &kp DE_LESS_THAN  &walrus          &kp DE_GREATER_THAN  &none
  &kp DE_HASH       &kp DE_DOLLAR   &kp DE_DOUBLE_QUOTES  &kp DE_UNDERSCORE    &mt DE_RIGHT_PARENTHESIS DE_LEFT_PARENTHESIS  &kp PAGE_DOWN  &bt BT_CLR_ALL  &kp TAB  &kp LEFT          &kp DOWN         &kp UP               &kp RIGHT
  &kp LEFT_CONTROL  &kp DE_EXCL     &kp DE_PIPE           &kp DE_EQUAL         &mt DE_RIGHT_BRACKET DE_LEFT_BRACKET                                         &none    &kp DE_AT         &kp DE_U_UMLAUT  &kp DE_A_UMLAUT      &kp DE_O_UMLAUT
                                    &kp LEFT_SHIFT        &kp LALT             &kp LEFT_GUI                                                                 &none    &none             &none
            >;
        };

        num {
            display-name = "num";

            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |

            bindings = <
  &none         &none             &kp DE_CARET  &none         &none  &none  &kp F12  &kp DE_ASTRK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none
  &backtick     &kp DE_BACKSLASH  &kp DE_COMMA  &kp DE_DOT    &none  &none  &none    &kp DE_MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DE_SLASH
  &forwardtick  &none             &none         &kp DE_TILDE  &none                  &kp DE_PLUS   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0
                                  &none         &none         &none                  &none         &none         &none
            >;
        };
    };
};
